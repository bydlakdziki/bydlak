---
interface Props {
  lang: 'pl' | 'en';
}
const { lang } = Astro.props;
---

<a class="instagram-link" href="https://www.instagram.com/drmartakryczka/" target="_blank" rel="noopener noreferrer" aria-label={lang === 'en' ? 'Dr Marta Kryczka on Instagram (opens in a new tab)' : 'Instagram dr Marty Kryczki (otwiera się w nowej karcie)'}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
  </svg>
</a>
