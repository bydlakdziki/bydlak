---
interface Props {
  lang: 'pl' | 'en';
}
const { lang } = Astro.props;
const isEn = lang === 'en';
---

<div class="booking-links">
  <div class="actions">
    <a class="btn" href="https://www.znanylekarz.pl/placowki/mei-clinic" target="_blank" rel="noopener">MEI Clinic — ZnanyLekarz</a>
    <a class="btn ghost" href="https://booksy.com/pl-pl/dl/show-business/287130" target="_blank" rel="noopener">KG Instytut Dr Grudzień — Booksy</a>
  </div>
  <p class="muted">{isEn
    ? 'KG Instytut Dr Grudzień: Jeździecka 6, 53-032 Wrocław. When booking, check that the appointment is with Dr Marta Kryczka. Booking services are in Polish.'
    : 'KG Instytut Dr Grudzień: ul. Jeździecka 6, 53-032 Wrocław. Przy rezerwacji sprawdź, czy wybrany termin dotyczy wizyty u dr Marty Kryczki.'}</p>
</div>
