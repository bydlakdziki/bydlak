---
interface Props {
  lang: 'pl' | 'en';
  variant?: 'list' | 'panel';
}
const { lang, variant = 'list' } = Astro.props;
const isEn = lang === 'en';
const znanyLekarz = 'https://www.znanylekarz.pl/profil/marta-kryczka';
const booksy = 'https://booksy.com/pl-pl/287130_kg-instytut-dr-grudzien-wroclaw_medycyna-estetyczna_13750_wroclaw/staffer/830466#ba_s=dl_1';
const note = isEn
  ? 'On ZnanyLekarz, select MEI Clinic at Inżynierska 27B on Dr Marta Kryczka’s profile. Booksy links directly to Marta at KG Instytut Dr Grudzień. Booking services are in Polish.'
  : 'Na profilu dr Marty Kryczki w ZnanyLekarz wybierz MEI Clinic przy ul. Inżynierskiej 27B. Link Booksy prowadzi bezpośrednio do Marty w KG Instytut Dr Grudzień.';
const places = [
  {
    name: 'MEI Clinic',
    address: `${isEn ? '' : 'ul. '}Inżynierska 27B, 53-228 Wrocław`,
    href: znanyLekarz,
    label: isEn ? 'Book via ZnanyLekarz' : 'Umów przez ZnanyLekarz',
  },
  {
    name: 'KG Instytut Dr Grudzień',
    address: `${isEn ? '' : 'ul. '}Jeździecka 6, 53-032 Wrocław`,
    href: booksy,
    label: isEn ? 'Book via Booksy' : 'Umów przez Booksy',
  },
];
---

{variant === 'panel' ? (
  <div class="booking-panel" id="umow-wizyte">
    <div class="booking-intro">
      <p class="eyebrow">{isEn ? 'Booking' : 'Rezerwacja'}</p>
      <h2>{isEn ? 'Book a visit' : 'Umów wizytę'}</h2>
      <p class="muted">{note}</p>
    </div>
    {places.map((place) => (
      <div class="booking-place">
        <span class="place-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" /></svg>
        </span>
        <h3>{place.name}</h3>
        <p class="muted">{place.address}</p>
        <a class="btn" href={place.href} target="_blank" rel="noopener" aria-label={`${place.label} – ${place.name}`}>{place.label}</a>
      </div>
    ))}
  </div>
) : (
  <div class="booking-links">
    <div class="actions">
      <a class="btn" href={znanyLekarz} target="_blank" rel="noopener">MEI Clinic — ZnanyLekarz</a>
      <a class="btn ghost" href={booksy} target="_blank" rel="noopener">KG Instytut Dr Grudzień — Booksy</a>
    </div>
    <p class="muted">MEI Clinic: {isEn ? 'Inżynierska 27B' : 'ul. Inżynierska 27B'}, 53-228 Wrocław.</p>
    <p class="muted">KG Instytut Dr Grudzień: {isEn ? 'Jeździecka 6' : 'ul. Jeździecka 6'}, 53-032 Wrocław.</p>
    <p class="muted">{note}</p>
  </div>
)}
