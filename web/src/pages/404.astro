      <div class="actions">
        <a class="btn ghost" href="/o-mnie/">O mnie</a>
        <a class="btn ghost" href="/zabiegi/">Zabiegi</a>
        <a class="btn ghost" href="/szkolenia/">Szkolenia</a>
        <a class="btn ghost" href="/artykuly/">Artykuły</a>
