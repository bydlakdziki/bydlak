---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('artykuly', (a) => !a.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const events = (await getCollection('aktualnosci', (a) => !a.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const trust = [
  { file: 'uniwersytet-medyczny-wroclaw.svg', alt: 'Uniwersytet Medyczny we Wrocławiu' },
  { file: 'danube-private-university.png', alt: 'Danube Private University' },
  { file: 'derma-medical.svg', alt: 'Derma Medical' },
  { file: 'pimik.svg', alt: 'Polski Instytut Medycyny i Kosmetologii' },
];

const sections = [
  { href: '/o-mnie/', img: 'gabinet-lekarza-dr-marta-kryczka', title: 'O mnie', text: 'Droga zawodowa, kwalifikacje i podejście do medycyny estetycznej oraz ortodoncji.' },
  { href: '/szkolenia/', img: 'szkolenia', title: 'Szkolenia', text: 'Edukacja dla lekarzy: biostymulacja, wypełniacze, toksyna botulinowa i laseroterapia.' },
  { href: '/zabiegi/', img: 'zabiegi', title: 'Zabiegi', text: 'Informacje o metodach, wskazaniach i ograniczeniach stosowanych w praktyce.' },
  { href: '/artykuly/', img: 'artykuly', title: 'Artykuły', text: 'Rzetelnie o medycynie estetycznej i ortodoncji.' },
];
---

<Base title="dr Marta Kryczka – medycyna estetyczna i ortodoncja, Wrocław" description="Lekarz dentysta łączący medycynę estetyczną i ortodoncję (Invisalign). Edukacja dla lekarzy: biostymulacja, wypełniacze, toksyna botulinowa, laseroterapia.">
  <section class="hero">
    <div class="container">
      <div>
        <p class="eyebrow">Lekarz dentysta · Wrocław</p>
        <h1>Medycyna estetyczna i ortodoncja z myślą o harmonii twarzy</h1>
        <p class="lead">
          Wiedza, odpowiedzialne podejście do zabiegów i edukacja dla lekarzy oraz osób zainteresowanych estetyką uśmiechu.
        </p>
        <div class="actions">
          <a class="btn" href="https://www.znanylekarz.pl/placowki/mei-clinic" target="_blank" rel="noopener">Umów wizytę</a>
          <a class="btn ghost" href="/szkolenia/">Szkolenia dla lekarzy</a>
          <a class="btn ghost" href="/o-mnie/">Poznaj moją historię</a>
        </div>
      </div>
      <img class="portrait" src="/img/dr-marta-kryczka-portret.webp" alt="Dr Marta Kryczka, lekarz dentysta, z filiżanką kawy" width="1200" height="1500" fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Moja wizja</p>
      <h2>Piękno, które zaczyna się od bezpieczeństwa</h2>
      <p>Patrzę na pacjenta całościowo. Łączę ortodontyczne spojrzenie na struktury kostne twarzy z troską o regenerację tkanek miękkich, bo harmonia twarzy zależy od jednego i drugiego.</p>
      <p>Wiem, jak ważne jest poczucie bezpieczeństwa, ponieważ sama byłam pacjentką onkologiczną. Dlatego bezpieczeństwo zabiegowe stawiam na pierwszym miejscu. Mam doświadczenie w planowaniu leczenia dla osób po chorobach nowotworowych i z zespołami autoimmunologicznymi.</p>
      <p>Szczególnie zapraszam osoby po radioterapii i chemioterapii, które chcą zadbać o swój wygląd w sposób przemyślany i bezpieczny. Każdy plan powstaje indywidualnie, po rozmowie i kwalifikacji, a o jego zakresie decyduje stan zdrowia.</p>
      <p><a class="btn" href="/kontakt/">Napisz do mnie</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="grid">
        {sections.map((s) => (
          <div class="card">
            <img class="card-img" src={`/img/${s.img}.webp`} alt="" width="1200" height="720" loading="lazy" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="more" href={s.href}>Przejdź →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Kształcenie i współpraca</p>
      <h2>Skąd czerpię wiedzę</h2>
      <div class="logo-strip">
        {trust.map((t) => (<img src={`/img/logos/${t.file}`} alt={t.alt} loading="lazy" />))}
      </div>
      <p class="muted">Uniwersytet Medyczny we Wrocławiu, ortodoncja w Danube Private University, medycyna estetyczna w Derma Medical w Londynie, a od 2024 r. prowadzę szkolenia w PIMiK. Opinie pacjentów znajdziesz w profilu gabinetu na <a href="https://www.znanylekarz.pl/placowki/mei-clinic" target="_blank" rel="noopener">ZnanyLekarz</a>.</p>
    </div>
  </section>

  {events.length > 0 && (
    <section class="section alt">
      <div class="container">
        <p class="eyebrow">Aktualności</p>
        <h2>Wydarzenia i konferencje</h2>
        <div class="grid">
          {events.map((e) => (
            <a class="card" href={`/aktualnosci/${e.id}/`} style="text-decoration:none;color:inherit">
              {e.data.image && <img class="card-img" src={e.data.image} alt={e.data.imageAlt} loading="lazy" />}
              <span class="tag">{e.data.type} · {e.data.date.toLocaleDateString('pl-PL')}</span>
              <h3>{e.data.title}</h3>
              <p>{e.data.description}</p>
            </a>
          ))}
        </div>
        <p><a href="/aktualnosci/">Wszystkie aktualności →</a></p>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Wiedza</p>
        <h2>Najnowsze artykuły</h2>
        <div class="grid">
          {latest.map((a) => (
            <a class="card" href={`/artykuly/${a.id}/`} style="text-decoration:none;color:inherit">
              {a.data.image && <img class="card-img" src={a.data.image} alt={a.data.imageAlt} loading="lazy" />}
              <span class="tag">{a.data.category}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="section alt">
    <div class="container ig-cta">
      <div>
        <p class="eyebrow">Instagram</p>
        <h2>Na co dzień na Instagramie</h2>
        <p class="muted">Relacje z konferencji, krótkie materiały edukacyjne i kulisy pracy. Zapraszam do obserwowania.</p>
      </div>
      <a class="btn" href="https://www.instagram.com/drmartakryczka/" target="_blank" rel="noopener">@drmartakryczka</a>
    </div>
  </section>
</Base>
