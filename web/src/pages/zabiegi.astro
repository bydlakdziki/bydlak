---
import Base from '../layouts/Base.astro';
import TopicIcon from '../components/TopicIcon.astro';
import BookingLinks from '../components/BookingLinks.astro';

const clinicUrl = 'https://www.znanylekarz.pl/placowki/mei-clinic';
const devices = [
  {
    name: 'Dermisonic 2',
    tagline: 'Ultradźwięki, radiofrekwencja i LED',
    text: 'Dermisonic 2 to urządzenie, które łączy mikromasaż ultradźwiękowy, radiofrekwencję i światło LED. Delikatnie pobudza skórę, wspiera krążenie i poprawia wchłanianie substancji aktywnych podawanych podczas zabiegu.',
    points: ['Mikromasaż i delikatne ogrzewanie tkanek', 'Światło LED dobierane do potrzeb skóry', 'Komfortowy przebieg, bez znieczulenia'],
    image: '/img/urzadzenia/dermisonic-2.webp',
  },
  {
    name: 'Synergy Marble Eye',
    tagline: 'Pielęgnacja delikatnej okolicy oczu',
    text: 'Synergy Marble Eye jest przeznaczony do okolicy oczu, czyli miejsca, w którym skóra jest najcieńsza. Łączy światło LED, mikrowibracje oraz naprzemienne działanie ciepła i chłodu, dzięki czemu zabieg jest relaksujący i dobrze uzupełnia pracę nad regeneracją tej okolicy.',
    points: ['Łagodne ciepło i chłód z głowicy kwarcowej', 'Czerwone i zielone światło LED', 'Zabieg skoncentrowany na okolicy oka'],
    image: '/img/urzadzenia/synergy-marble-eye.webp',
  },
];
const items = [
  { title: 'Biostymulacja', text: 'Metody wspierające jakość i napięcie skóry. Zakres i oczekiwania omawiane są indywidualnie podczas konsultacji.' },
  { title: 'Wypełniacze', text: 'Zabiegi modelujące proporcje twarzy, planowane z uwzględnieniem anatomii i zasady umiaru.' },
  { title: 'Toksyna botulinowa', text: 'Zabiegi stosowane m.in. w redukcji zmarszczek mimicznych; kwalifikacja zawsze poprzedza decyzję.' },
  { title: 'Laseroterapia', text: 'Metody wykorzystujące energię światła; dobór postępowania zależy od wskazań i stanu skóry.' },
  { title: 'Osocze bogatopłytkowe i fibryna bogatopłytkowa', text: 'Preparaty autologiczne, czyli uzyskiwane z krwi pacjenta, wykorzystywane do wspierania regeneracji i jakości skóry. Wskazania i technikę ocenia się indywidualnie.' },
  { title: 'Kwas polimlekowy', text: 'Biostymulator tkankowy, który stopniowo pobudza skórę do produkcji własnego kolagenu. Efekt narasta z czasem, a plan postępowania zależy od wskazań i budowy tkanek.' },
  { title: 'Hydroksyapatyt wapnia', text: 'Preparat o właściwościach biostymulujących i podporowych. Dobór techniki i miejsca podania zależy od jakości skóry oraz anatomii.' },
  { title: 'Enzymy rekombinowane', text: 'Preparaty enzymatyczne stosowane m.in. do rozpuszczania wypełniaczy oraz w pracy z tkanką łączną. Wskazania ocenia się indywidualnie.' },
  { title: 'Nici booster', text: 'Cienkie nici wprowadzane w skórę, które poprawiają jej napięcie i jakość. Kwalifikacja obejmuje ocenę anatomii, ułożenia tkanek i oczekiwań.' },
  { title: 'Mezoterapia', text: 'Mikrowstrzyknięcia substancji aktywnych w skórę, służące poprawie jej kondycji. Skład i technikę dobiera się do potrzeb skóry.' },
  { title: 'Tropokolagen', text: 'Podstawowa cząsteczka, z której powstają włókna kolagenowe. W medycynie estetycznej omawiany w kontekście wsparcia struktury skóry.' },
  { title: 'Leczenie ortodontyczne Invisalign', text: 'Leczenie wad zgryzu nakładkami lub innymi aparatami, z uwzględnieniem proporcji twarzy i uśmiechu.' },
];
---

<Base title="Medycyna estetyczna i Invisalign" description="Rzetelne informacje o metodach medycyny estetycznej i ortodoncji, zabiegi we Wrocławiu: biostymulatory, wypełniacze, toksyna botulinowa, nici, mezoterapia, laseroterapia, leczenie nakładkami Invisalign.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Zabiegi</p>
      <h1>Zabiegi w odpowiedzialnym ujęciu</h1>
      <p class="lead">Rzetelne informacje o metodach. Nie każdy zabieg jest dla każdego, a kwalifikacja zawsze odbywa się podczas konsultacji.</p>
      <p class="lead"><strong>Miejsce wykonywania zabiegów:</strong> Wrocław.</p>
      <BookingLinks lang="pl" />
    </div>
  </section>

  <section class="section alt">
    <div class="container"><img class="banner" src="/img/zabiegi.webp" alt="Spokojny gabinet medycyny estetycznej" width="1920" height="1080" /></div>
    <div class="container">
      <div class="grid">
        {items.map((i) => (
          <div class="card"><TopicIcon name={i.title} /><h3>{i.title}</h3><p>{i.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Urządzenia</p>
      <h2>Technologie, z których korzystam</h2>
      <p class="lead">Zabiegi z użyciem urządzeń są nieinwazyjne i mogą uzupełniać pozostałe metody. Dobór technologii zawsze poprzedza konsultacja.</p>
      <div class="device-list">
        {devices.map((d) => (
          <article class="device">
            {d.image && <img class="device-img" src={d.image} alt={d.name} loading="lazy" />}
            <div class="device-body">
              <h3>{d.name}</h3>
              <p class="tag">{d.tagline}</p>
              <p>{d.text}</p>
              <ul>{d.points.map((p) => <li>{p}</li>)}</ul>
              <a class="btn" href={clinicUrl} target="_blank" rel="noopener">MEI Clinic — ZnanyLekarz</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container prose">
      <p>Zabiegi wykonuję we Wrocławiu. Wybierz miejsce i zarezerwuj wizytę przez ZnanyLekarz lub Booksy.</p>
      <BookingLinks lang="pl" />
      <p class="notice">Opisy mają charakter wyłącznie informacyjny i nie stanowią porady medycznej. Nie zawierają obietnic efektów. Każdy zabieg poprzedza konsultacja i kwalifikacja.</p>
    </div>
  </section>
</Base>
