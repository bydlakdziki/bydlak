---
import Base from '../layouts/Base.astro';

const topics = [
  { title: 'Biostymulacja', text: 'Mechanizmy działania, dobór preparatów i metod, ograniczenia dowodów.' },
  { title: 'Wypełniacze', text: 'Anatomia, planowanie zabiegu, bezpieczeństwo i postępowanie w powikłaniach.' },
  { title: 'Toksyna botulinowa', text: 'Wskazania, kwalifikacja pacjenta, praktyczne podejście do dawkowania i oczekiwań.' },
  { title: 'Laseroterapia', text: 'Zasady działania, kwalifikacja i bezpieczne planowanie postępowania.' },
];
---

<Base title="Szkolenia" description="Szkolenia z medycyny estetycznej dla lekarzy: biostymulacja, wypełniacze, toksyna botulinowa i laseroterapia.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Szkolenia</p>
      <h1>Edukacja dla lekarzy</h1>
      <p class="lead">Szkolenia poświęcone rozumowaniu klinicznemu i bezpiecznej praktyce w medycynie estetycznej.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Tematy</h2>
      <div class="grid">
        {topics.map((t) => (
          <div class="card"><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Terminy i program</h2>
      <p class="notice">Do uzupełnienia: informacje o aktualnych szkoleniach, organizatorach i sposobie kontaktu. Na obecnym etapie strona ma charakter informacyjny i nie służy sprzedaży miejsc.</p>
    </div>
  </section>
</Base>
