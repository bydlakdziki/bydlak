---
import Base from '../layouts/Base.astro';
---

<Base title="Kontakt" description="Kontakt z dr Martą Kryczką: pytania o współpracę, szkolenia i zabiegi. Formularz kontaktowy.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1>Napisz do mnie</h1>
      <p class="lead">Masz pytanie o szkolenia, współpracę lub zabiegi? Wyślij wiadomość, odpowiem najszybciej, jak to możliwe. Wizytę możesz też umówić przez <a href="https://www.znanylekarz.pl/placowki/mei-clinic" target="_blank" rel="noopener">ZnanyLekarz</a>.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p id="form-status" class="form-status" role="status" hidden></p>
      <form class="contact-form" method="post" action="/wyslij.php">
        <label>Imię i nazwisko<input type="text" name="name" required maxlength="120" autocomplete="name" /></label>
        <label>Adres e-mail<input type="email" name="email" required maxlength="160" autocomplete="email" /></label>
        <label>Temat<input type="text" name="subject" maxlength="160" /></label>
        <label>Wiadomość<textarea name="message" rows="6" required maxlength="5000"></textarea></label>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="check"><input type="checkbox" name="consent" required /> Wyrażam zgodę na przetwarzanie moich danych w celu odpowiedzi na wiadomość. Nie przesyłaj w formularzu danych o stanie zdrowia.</label>
        <button class="btn" type="submit">Wyślij wiadomość</button>
      </form>
    </div>
  </section>

  <script>
    const status = document.getElementById('form-status');
    const s = new URLSearchParams(location.search).get('status');
    if (status && s) {
      status.hidden = false;
      status.className = 'form-status ' + (s === 'ok' ? 'ok' : 'err');
      status.textContent = s === 'ok' ? 'Dziękuję, wiadomość została wysłana.' : 'Nie udało się wysłać wiadomości. Sprawdź dane i spróbuj ponownie.';
    }
  </script>
</Base>
