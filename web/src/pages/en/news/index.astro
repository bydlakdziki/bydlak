---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('aktualnosci-en', (a) => !a.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Conferences and events" description="Reports from aesthetic medicine conferences, exams and media appearances by dr Marta Kryczka: PTMEiAA, Slow Medicine, Medonet.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">News</p>
      <h1>Events and conferences</h1>
      <p class="lead">Reports from conferences, courses and professional meetings I attend.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container">
      {events.length === 0 ? (
        <p class="muted">The first posts will appear soon.</p>
      ) : (
        <div class="grid">
          {events.map((e) => (
            <a class="card" href={`/en/news/${e.id}/`} style="text-decoration:none;color:inherit">
              {e.data.image && <img class="card-img" src={e.data.image} alt={e.data.imageAlt} loading="lazy" />}
              <span class="tag">{e.data.type} · {e.data.date.toLocaleDateString('en-GB')}</span>
              <h3>{e.data.title}</h3>
              {e.data.location && <p class="muted">{e.data.location}</p>}
              <p>{e.data.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
