---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('artykuly-en', (a) => !a.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Articles on aesthetic medicine" description="Educational articles by dr Marta Kryczka on aesthetic medicine and orthodontics: laser therapy, biostimulators, combined protocols, Invisalign.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Articles</p>
      <h1>Knowledge in practice</h1>
      <p class="lead">Educational texts on aesthetic medicine and orthodontics.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container"><img class="banner" src="/img/artykuly.webp" alt="Notebook, glasses and a plant on a beige countertop" width="1600" height="900" /></div>
    <div class="container">
      {articles.length === 0 ? (
        <p class="muted">The first articles will appear soon.</p>
      ) : (
        <div class="grid">
          {articles.map((a) => (
            <a class="card" href={`/en/articles/${a.id}/`} style="text-decoration:none;color:inherit">
              {a.data.image && <img class="card-img" src={a.data.image} alt={a.data.imageAlt} loading="lazy" />}
              <span class="tag">{a.data.category} · {a.data.date.toLocaleDateString('en-GB')}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
