---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('artykuly-en', (a) => !a.data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Base
  title={article.data.title}
  description={article.data.description}
  image={article.data.image}
  imageAlt={article.data.imageAlt}
  type="article"
  published={article.data.date}
  jsonLd={[{
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.date.toISOString(),
    dateModified: article.data.date.toISOString(),
    inLanguage: 'en-GB',
    image: article.data.image ? new URL(article.data.image, Astro.site).href : undefined,
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    author: { '@id': 'https://drmartakryczka.pl/#person' },
    publisher: { '@id': 'https://drmartakryczka.pl/#person' },
  }]}
>
  <article class="section">
    <div class="container prose">
      <p class="eyebrow">{article.data.category} · {article.data.date.toLocaleDateString('en-GB')}</p>
      <h1>{article.data.title}</h1>
      {article.data.image && <img class="banner" src={article.data.image} alt={article.data.imageAlt} width="1600" height="900" />}
      <Content />
      <p><a href="/en/articles/">← All articles</a></p>
    </div>
  </article>
</Base>
