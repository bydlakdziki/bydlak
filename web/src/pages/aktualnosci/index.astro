---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('aktualnosci', (a) => !a.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Konferencje i wydarzenia" description="Relacje z konferencji medycyny estetycznej, egzaminów i publikacji w mediach z udziałem dr Marty Kryczki: PTMEiAA, Slow Medicine, Medonet.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Aktualności</p>
      <h1>Wydarzenia i konferencje</h1>
      <p class="lead">Relacje z konferencji, szkoleń i spotkań branżowych, w których biorę udział.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container">
      {events.length === 0 ? (
        <p class="muted">Pierwsze wpisy pojawią się wkrótce.</p>
      ) : (
        <div class="grid">
          {events.map((e) => (
            <a class="card" href={`/aktualnosci/${e.id}/`} style="text-decoration:none;color:inherit">
              {e.data.image && <img class="card-img" src={e.data.image} alt={e.data.imageAlt} loading="lazy" />}
              <span class="tag">{e.data.type} · {e.data.date.toLocaleDateString('pl-PL')}</span>
              <h3>{e.data.title}</h3>
              {e.data.location && <p class="muted">{e.data.location}</p>}
              <p>{e.data.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
