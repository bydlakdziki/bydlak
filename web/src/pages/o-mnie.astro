---
import Base from '../layouts/Base.astro';

const qualifications = [
  { title: 'Lekarz dentysta', text: 'Wydział Lekarsko-Stomatologiczny Uniwersytetu Medycznego we Wrocławiu (2004–2011), staż podyplomowy 2011–2012.' },
  { title: 'Ortodoncja', text: 'Master of Science in Orthodontics, Danube Private University w Krems (Austria), 2017–2020. Praktyka w leczeniu nakładkami Invisalign.' },
  { title: 'Medycyna estetyczna', text: 'Level 7 Facial Aesthetic Therapies, Derma Medical w Londynie (2021–2023). Następnie egzaminator wewnętrzny, odpowiedzialny za certyfikację i ocenę kompetencji innych lekarzy.' },
  { title: 'Edukacja', text: 'Trener medycyny estetycznej twarzy w Polskim Instytucie Medycyny i Kosmetologii (od 2024).' },
];

const treatments = ['toksyna botulinowa', 'biostymulacja', 'terapie enzymatyczne', 'wolumetria', 'modelowanie ust'];

const career = [
  { years: '2026', title: 'Umiejętność zawodowa – Medycyna Estetyczno-Naprawcza (kod 028)', place: 'Polskie Towarzystwo Medycyny Estetycznej i Anti-Aging', text: 'Egzamin zdany w październiku 2026 r. Uczestniczę też w kongresach i konferencjach branżowych w Polsce.' },
  { years: 'od 2024', title: 'Trener medycyny estetycznej twarzy', place: 'Polski Instytut Medycyny i Kosmetologii', text: 'Prowadzę szkolenia dla lekarzy z zakresu medycyny estetycznej twarzy.' },
  { years: 'od 2024', title: 'Lekarz ortodonta', place: 'Leczenie nakładkami Invisalign', text: 'Planuję i prowadzę leczenie ortodontyczne przezroczystymi nakładkami, łącząc perspektywę ortodonty i medycyny estetycznej.' },
  { years: '2021–2023', title: 'Egzaminator wewnętrzny i specjalizacja w medycynie estetycznej', place: 'Derma Medical, Londyn', text: 'Nauka w programie Level 7 Facial Aesthetic Therapies, a następnie rola egzaminatora wewnętrznego: odpowiadałam za proces certyfikacji i ocenę kompetencji innych lekarzy.' },
  { years: '2014–2023', title: 'Lekarz dentysta, praktyka prywatna i NHS', place: 'hrabstwo East Sussex, Wielka Brytania', text: 'Dziewięć lat pracy w brytyjskim systemie opieki zdrowotnej i w praktyce prywatnej: stomatologia, ortodoncja i stopniowo coraz szerszy zakres medycyny estetycznej.' },
  { years: 'od 2014', title: 'Własna praktyka – Unique Smile Center', place: 'East Sussex', text: 'Prowadzenie własnej praktyki, w której łączyłam stomatologię, ortodoncję i medycynę estetyczną.' },
  { years: '2012–2014', title: 'Lekarz dentysta', place: 'praktyka prywatna, Wrocław', text: 'Pierwsze lata pracy po stażu podyplomowym.' },
];
---

<Base title="O mnie" description="dr Marta Kryczka – droga zawodowa, kwalifikacje i podejście do medycyny estetycznej oraz ortodoncji.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">O mnie</p>
      <h1>dr Marta Kryczka</h1>
      <p class="lead">Lekarz dentysta łączący ortodoncję i medycynę estetyczną. Patrzę na twarz kompleksowo, a wiedzą dzielę się z lekarzami w całej Polsce.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <img class="about-photo" src="/img/dr-marta-kryczka-lekarz-dentysta-wroclaw.webp" width="900" height="1350" alt="dr Marta Kryczka – lekarz dentysta, ortodoncja i medycyna estetyczna, Wrocław" />
      <div class="prose">
        <h2>Moje podejście</h2>
        <p>Nazywam się Marta Kryczka. Jestem absolwentką Wydziału Lekarsko-Stomatologicznego Uniwersytetu Medycznego we Wrocławiu. Ortodoncję studiowałam na Danube Private University w Krems w Austrii, a kompetencje w medycynie estetycznej poszerzyłam w Derma Medical w Londynie. Tam objęłam funkcję egzaminatora wewnętrznego, odpowiadając za proces certyfikacji i ocenę kompetencji innych lekarzy.</p>
        <p>Przez ostatnie 10 lat pracowałam w hrabstwie East Sussex na południu Anglii, gdzie prowadziłam również własną praktykę, Unique Smile Center. Wieloletnie doświadczenie w stomatologii, ortodoncji i medycynie estetycznej pozwala mi patrzeć na twarz w sposób kompleksowy.</p>
        <p>W swojej pracy szczególną uwagę poświęcam harmonii i proporcjom twarzy, uwzględniając zarówno zmiany związane ze starzeniem, jak i wpływ wad zgryzu na estetykę oraz funkcję tkanek.</p>
        <p>W klinice wykonuję zabiegi z zakresu: {treatments.join(', ')}. Do każdego pacjenta podchodzę indywidualnie i holistycznie, biorąc pod uwagę jego potrzeby i oczekiwania.</p>
        <p>Mówię po polsku i po angielsku (poziom C2).</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Kwalifikacje i certyfikaty</h2>
      <div class="grid">
        {qualifications.map((q) => (
          <div class="card"><h3>{q.title}</h3><p>{q.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Doświadczenie zawodowe</h2>
      <p>Droga zawodowa łączy pracę kliniczną w Polsce i Wielkiej Brytanii z nauczaniem i certyfikacją innych lekarzy.</p>
      <div class="timeline">
        {career.map((c) => (
          <div class="timeline-item">
            <span class="timeline-years">{c.years}</span>
            <h3>{c.title}</h3>
            <p class="timeline-place">{c.place}</p>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
