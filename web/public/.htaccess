RewriteEngine On

# Katalog bez ukośnika -> od razu https, bez www i z ukośnikiem (jeden skok; reguła przed ogólną)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://drmartakryczka.pl/$1/ [L,R=301]

# Wymuszenie HTTPS i wersji bez www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://drmartakryczka.pl%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Pozostałości po typowych stronach CMS (WordPress) – trwale usunięte (410)
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/|$) - [G,L]
RewriteRule ^(wp-login|wp-cron|xmlrpc)\.php$ - [G,L]
RewriteRule ^(feed|author)(/|$) - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(s|author)= [NC]
RewriteRule ^ - [G,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Astro dodaje hash do nazw plików w /_astro/, więc można je cache'ować na stałe
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
